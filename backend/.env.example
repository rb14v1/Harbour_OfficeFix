# Copy this file to backend/.env and replace the placeholders. Never commit backend/.env.
# PostgreSQL URL format: postgresql://<user>:<password>@<host>:<port>/<database>

# Django secret key. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<generate-a-long-random-secret>
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Application database (local: officefix). Azure: add ?sslmode=require to the URL.
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/officefix
# Schema inside the database that holds the Django tables. Created once with CREATE SCHEMA.
DJANGO_DB_SCHEMA=django_app

# Test database (must be named like *_test). Used only by `manage.py test`.
TEST_DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/officefix_test
DJANGO_TEST_SCHEMA=django_test

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
