# Copy this file to backend/.env and replace the placeholders. Never commit backend/.env.
# PostgreSQL URL format: postgresql://<user>:<password>@<host>:<port>/<database>

# Django secret key. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# true/false. Enable only for local development.
DJANGO_DEBUG=
# Comma-separated host names the backend may serve.
DJANGO_ALLOWED_HOSTS=

# Application database URL. Azure: add ?sslmode=require to the URL.
DATABASE_URL=
# Schema inside the database that holds the Django tables. Created once with CREATE SCHEMA.
DJANGO_DB_SCHEMA=
# Seconds a database connection is kept open for reuse (whole number, 0 closes after each request).
DB_CONN_MAX_AGE=

# Test database URL (database must be named like *_test). Used only by `manage.py test`.
TEST_DATABASE_URL=
DJANGO_TEST_SCHEMA=

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=
