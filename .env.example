# Copy this file to .env in the project root for docker compose. Never commit .env.

# PostgreSQL URL as seen from inside the containers.
# When the database runs on your Windows machine, use host.docker.internal instead of localhost.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Long random string. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Schema that holds the application tables inside the database.
DJANGO_DB_SCHEMA=

# Seconds a database connection is kept open for reuse (whole number, 0 closes after each request).
DB_CONN_MAX_AGE=

# Browser origin(s) for the app when served by docker compose (comma-separated).
CORS_ORIGINS=
# Comma-separated host names the backend may serve (include the compose service name).
DJANGO_ALLOWED_HOSTS=
